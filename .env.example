# Required in every environment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/abogados_ia"
JWT_SECRET="use-a-unique-random-secret-of-at-least-32-characters"
OPENAI_API_KEY=""

# File storage: choose one supported provider and configure its credentials.
STORAGE_PROVIDER="gcs"
GCS_BUCKET=""
BLOB_READ_WRITE_TOKEN=""

# Email notifications (optional)
RESEND_API_KEY=""
EMAIL_FROM=""

# Stripe payments (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Client portal. Keep this false unless identity verification for existing
# clients is handled outside the public registration flow.
PORTAL_AUTO_LINK_EXISTING_CLIENTS="false"
ABOGADO_ADMIN_ID=""

# Emergency account recovery. Keep disabled in normal operation.
RESET_ACCOUNTS_ENABLED="false"
RESET_ACCOUNTS_TOKEN=""
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_USER_EMAIL=""
DEFAULT_USER_PASSWORD=""
