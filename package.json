    "test:legal-db": "tsx scripts/test-legal-db.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.10.0",
    "@prisma/client": "5.16.1",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tiptap/react": "^2.5.8",
    "@tiptap/starter-kit": "^2.5.8",
    "@vercel/blob": "^0.23.2",
    "bcryptjs": "2.4.3",
    "cookie": "0.6.0",
    "docx": "^8.5.0",
    "formidable": "3.5.4",
    "jsonwebtoken": "9.0.2",
    "next": "15.5.12",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "^0.14.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "^6.9.4",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/formidable": "^3.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "25.2.2",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.12",
    "prisma": "5.16.1",
    "tsx": "4.21.0",
    "typescript": "5.5.4"
  }
