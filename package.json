  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "clean:codes": "tsx scripts/cleanupCodes.ts",
    "db:reset:content": "tsx scripts/resetContent.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "embeddings": "node scripts/generarEmbeddings.js",
    "test:rag:regression": "node scripts/ragRegression.js",
    "hooks:enable": "git config core.hooksPath .githooks",
    "hooks:disable": "git config --unset core.hooksPath || true",
    "import:cnpcf": "tsx scripts/importarCNPCF.ts",
    "import:gto": "tsx scripts/importarGTO.ts",
    "seed:servicios": "tsx prisma/seed-servicios.ts",
    "seed:legal-catalog": "tsx scripts/seed-legal-catalog.ts",
